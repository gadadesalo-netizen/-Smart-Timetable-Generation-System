<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Timetable Generator</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

<nav class="navbar navbar-dark bg-primary">
    <div class="container-fluid">
        <span class="navbar-brand">Smart Timetable Generator</span>

        <a href="/dashboard" class="btn btn-light">
            Dashboard
        </a>
    </div>
</nav>

<div class="container mt-4">

<div class="card shadow">

<div class="card-header">
<h4>Automatic Timetable Generation</h4>
</div>

<div class="card-body">

<p>
Click the button below to automatically generate the timetable.
</p>

<button class="btn btn-success" onclick="generateTimetable()">
Generate Timetable
</button>

<button class="btn btn-primary" onclick="loadTimetable()">
Refresh
</button>

</div>

</div>

<br>

<div class="card shadow">

<div class="card-header">
Generated Timetable
</div>

<div class="card-body">

<table class="table table-bordered">

<thead class="table-primary">

<tr>

<th>Day</th>
<th>Slot</th>
<th>Division</th>
<th>Subject</th>
<th>Faculty</th>
<th>Room</th>
<th>Type</th>

</tr>

</thead>

<tbody id="timetableTable">

</tbody>

</table>

</div>

</div>

</div>

<script src="/static/timetable.js"></script>

</body>
</html>
