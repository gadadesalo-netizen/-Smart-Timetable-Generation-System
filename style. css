body{
    background:#f4f6f9;
    font-family:Arial,Helvetica,sans-serif;
}

.navbar{
    box-shadow:0 2px 8px rgba(0,0,0,.2);
}

.card{
    border:none;
    border-radius:12px;
    transition:.3s;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 5px 20px rgba(0,0,0,.2);
}

.card-body h2{
    color:#0d6efd;
    font-weight:bold;
}

.btn{
    margin:5px;
    border-radius:8px;
}

.table{
    background:white;
}

.login-box{
    max-width:400px;
    margin:auto;
    margin-top:100px;
}

.sidebar{
    width:250px;
    height:100vh;
    position:fixed;
    background:#0d6efd;
    color:white;
}

.sidebar a{
    color:white;
    display:block;
    padding:15px;
    text-decoration:none;
}

.sidebar a:hover{
    background:#0b5ed7;
}

.content{
    margin-left:260px;
    padding:20px;
}
