<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Faculty Management</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/static/style.css">

</head>

<body>

<nav class="navbar navbar-dark bg-primary">

<div class="container-fluid">

<span class="navbar-brand">
Faculty Management
</span>

<a href="/dashboard" class="btn btn-light">
Dashboard
</a>

</div>

</nav>

<div class="container mt-4">

<div class="card shadow">

<div class="card-header">

<h4>Add Faculty</h4>

</div>

<div class="card-body">

<div class="row">

<div class="col-md-4">
<input id="name" class="form-control" placeholder="Faculty Name">
</div>

<div class="col-md-4">
<input id="department" class="form-control" placeholder="Department">
</div>

<div class="col-md-4">
<input id="email" class="form-control" placeholder="Email">
</div>

</div>

<br>

<div class="row">

<div class="col-md-4">
<input id="phone" class="form-control" placeholder="Phone">
</div>

<div class="col-md-4">
<input id="designation" class="form-control" placeholder="Designation">
</div>

<div class="col-md-4">
<input id="workload" type="number" class="form-control" placeholder="Max Workload">
</div>

</div>

<br>

<button onclick="saveFaculty()" class="btn btn-success">
Save Faculty
</button>

</div>

</div>

<br>

<div class="card shadow">

<div class="card-header">

<h4>Faculty List</h4>

</div>

<div class="card-body">

<table class="table table-bordered">

<thead class="table-primary">

<tr>

<th>ID</th>
<th>Name</th>
<th>Department</th>
<th>Email</th>
<th>Phone</th>
<th>Designation</th>
<th>Workload</th>
<th>Action</th>

</tr>

</thead>

<tbody id="facultyTable">

</tbody>

</table>

</div>

</div>

</div>

<script src="/static/faculty.js"></script>

</body>
</html>
