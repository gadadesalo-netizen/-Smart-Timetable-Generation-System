<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Division Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

<nav class="navbar navbar-dark bg-primary">
    <div class="container-fluid">
        <span class="navbar-brand">Division Management</span>
        <a href="/dashboard" class="btn btn-light">Dashboard</a>
    </div>
</nav>

<div class="container mt-4">

<div class="card shadow">

<div class="card-header">
<h4>Add Division</h4>
</div>

<div class="card-body">

<div class="row">

<div class="col-md-4">
<input id="academic_year" class="form-control" placeholder="Academic Year">
</div>

<div class="col-md-4">
<input id="division_name" class="form-control" placeholder="Division Name">
</div>

<div class="col-md-4">
<input id="students" type="number" class="form-control" placeholder="Students">
</div>

</div>

<br>

<button onclick="saveDivision()" class="btn btn-success">
Save Division
</button>

</div>

</div>

<br>

<div class="card shadow">

<div class="card-header">
<h4>Division List</h4>
</div>

<div class="card-body">

<table class="table table-bordered">

<thead class="table-primary">
<tr>
<th>ID</th>
<th>Academic Year</th>
<th>Division</th>
<th>Students</th>
</tr>
</thead>

<tbody id="divisionTable">

</tbody>

</table>

</div>

</div>

</div>

<script src="/static/divisions.js"></script>

</body>
</html>
